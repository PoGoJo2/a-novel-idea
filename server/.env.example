PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/a-novel-idea
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Optional: turns on Claude-powered answers in the reading helper (without it, built-in answers are used)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
